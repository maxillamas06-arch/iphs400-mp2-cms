# Copy to .env (which is gitignored) and change the values. On a fresh clone
# with no .env, the app and the seed read this file instead.
CMS_SECRET_KEY=change-me-to-a-long-random-string
CMS_SITE_TITLE=Club de Aficionados Albiazul
CMS_DATABASE=cms.db
# Demo accounts created by scripts/seed_demo.py (both members share the editor password)
CMS_ADMIN_PASSWORD=change-me-admin
CMS_EDITOR_PASSWORD=change-me-editor
# Set after you deploy, e.g. https://yourname.github.io/iphs400-mp2-cms/
CMS_BASE_PATH=
# Your name for the transcript hook, lowercase, e.g. ana-garcia
CMS_STUDENT=first-last
